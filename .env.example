# Variables lues par le code — copier ce fichier vers .env.local et remplir.
# Base locale (dev et tests) : chemin du fichier SQLite. Défaut : data/pipeline.db
PIPELINE_DB_PATH=
# Base managée (prod) : si TURSO_URL est défini, l'app parle à Turso et
# PIPELINE_DB_PATH est ignoré. Ne jamais commiter .env.local.
TURSO_URL=
TURSO_AUTH_TOKEN=
